/* =========================================================================
   TalkVinyl. — Base global
   ========================================================================= */

@import url('https://fonts.googleapis.com/css2?family=Special+Elite&family=Oswald:wght@400;600&family=Inter:wght@400;500;600&display=swap');

:root {
  /* Colores - Vintage E-commerce Refined */
  --black:      #1a1714;
  --black-2:    #24211d;
  --paper:      #2b2823;
  --paper-2:    #3a352f;
  --off-white:  #fdf8f0;
  --red:        #b83b3b;
  --red-d:      #8c2121;
  --yellow:     #d4a373;
  --teal:       #4a7c59;
  --success:    #4a7c59;
  --warning:    #d4a373;
  --danger:     #b83b3b;
  --brown:      #a68a64;

  /* Tipografía */
  --font-display: 'Oswald', sans-serif;
  --font-body:    'Inter', sans-serif;
  --font-accent:  'Special Elite', monospace;

  /* Bordes y sombras */
  --border:      1px solid var(--brown);
  --border-thin: 1px solid rgba(166, 138, 100, 0.3);
  --shadow:      2px 4px 12px rgba(0, 0, 0, 0.4);
  --shadow-sm:   1px 2px 6px rgba(0, 0, 0, 0.3);
  --radius:      6px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-body);
  color: var(--off-white);
  background-color: var(--black);
  background-image: url('/fondo.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-repeat: no-repeat;
}

/* ... resto igual ... */

/* ---------- TIPOGRAFÍA BASE ---------- */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  color: var(--off-white);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin: 0 0 12px;
}
h1 {
  font-size: 2.4rem;
  color: var(--red);
  text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
}
h2 { font-size: 1.5rem; border-bottom: 2px dashed var(--brown); padding-bottom: 8px; }
h3 { font-size: 1.05rem; }

/* ---------- SCROLLBAR OCULTO ---------- */
* {
  scrollbar-width: none;      /* Firefox */
  -ms-overflow-style: none;   /* Edge / IE */
}
*::-webkit-scrollbar {
  display: none;              /* Chrome / Safari / Edge moderno */
}